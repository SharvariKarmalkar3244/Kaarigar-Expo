FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -B -f pom.xml -pl kaarigar-service -am package -Dmaven.test.skip=true

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/kaarigar-service/target/kaarigar-service-1.0.0.jar /app/app.jar
ENV SPRING_PROFILES_ACTIVE=vercel
EXPOSE 80
ENTRYPOINT ["sh", "-c", "exec java -Dserver.port=${PORT:-80} -jar /app/app.jar"]
